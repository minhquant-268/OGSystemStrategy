# .gitignore - System Strategy

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Environment
.env
*.env

# IDE
.vscode/
.idea/

# Logs
*.log
logs/

# Data (không push raw data lên git)
data/raw/
data/processed/

# Config chứa credentials (chỉ push template, không push file thực)
config/server_config.json

# Redis dump
dump.rdb
